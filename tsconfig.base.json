{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "jsx": "react-jsx",
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "@boss-cli/protocol": ["./packages/protocol/src/index.ts"],
      "@boss-cli/app-client": ["./packages/app-client/src/index.ts"],
      "@boss-cli/shared": ["./packages/shared/src/index.ts"]
    }
  }
}
